# ==========================================
# CONFIGURACAO DO PROJETO - MAQUETE INDUSTRIAL
# ==========================================
# Copie este arquivo para .env e preencha os valores

# Backend
PORT=4000
NODE_ENV=development

# Banco de Dados - Supabase (obrigatorio)
DATABASE_URL=postgresql://postgres:SENHA@db.PROJECT_REF.supabase.co:5432/postgres

# Redis externo (obrigatorio)
REDIS_URL=redis://HOST_REDIS:6379

# JWT
JWT_SECRET=chave_secreta_forte_para_producao
JWT_EXPIRES_IN=86400000

# Gateway API
GATEWAY_API_KEY=chave_api_gateway

# Supabase (obrigatorio)
SUPABASE_URL=https://SEU_PROJETO.supabase.co
SUPABASE_ANON_KEY=SUA_ANON_KEY
SUPABASE_JWT_SECRET=SEU_JWT_SECRET_DO_SUPABASE_DASHBOARD

# Dashboard (build time)
REACT_APP_API_URL=http://localhost:4000
REACT_APP_SUPABASE_URL=https://SEU_PROJETO.supabase.co
REACT_APP_SUPABASE_ANON_KEY=SUA_ANON_KEY

# Gateway
SIMULATION_MODE=true
BT_DEVICE_FERROVIA=98:D3:31:FD:15:F5
BT_DEVICE_TRUCK01=98:D3:31:FD:15:A1
GATEWAY_ID=gateway-docker-01

# Logging
LOG_LEVEL=info
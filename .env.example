# ==========================================
# CONFIGURACAO DO PROJETO - MAQUETE INDUSTRIAL
# ==========================================
# Copie este arquivo para .env e preencha os valores

# PostgreSQL na nuvem (Supabase) — use o Connection Pooler (Session mode),
# não a conexão direta: o host direto costuma ter apenas endereço IPv6.
DATABASE_URL=postgresql://postgres.seu-projeto:sua_senha@aws-0-sua-regiao.pooler.supabase.com:5432/postgres

# JWT (autenticacao) - Mude em producao!
JWT_SECRET=chave_secreta_para_desenvolvimento
JWT_EXPIRES_IN=24h

# Gateway API - Mude em producao!
GATEWAY_API_KEY=chave_api_gateway

# Backend
PORT=4000
NODE_ENV=development

# Dashboard
REACT_APP_API_URL=http://localhost:4000

# Gateway Bluetooth
SIMULATION_MODE=true
BT_DEVICE_FERROVIA=98:D3:31:FD:15:F5
BT_DEVICE_TRUCK01=98:D3:31:FD:15:A1

# Logging
LOG_LEVEL=info

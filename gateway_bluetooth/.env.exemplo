# Gateway Bluetooth - Configuracao

# Conexao com Back-end
BACKEND_WS_URL=...
BACKEND_API_URL=...

# Identificação do Gateway
GATEWAY_API_KEY=...
GATEWAY_ID=...

# Dispositivos Bluetooth HC-05 (enderecos MAC)
BT_DEVICE_FERROVIA=...
BT_DEVICE_TRUCK01=...

# Configuracao Serial
SERIAL_BAUD=...
RECONNECT_INTERVAL=...
HEARTBEAT_INTERVAL=...

# Logging
LOG_LEVEL=...

SIMULATION_MODE=true

# Health Check
HEALTH_PORT=3001

# Simulation intervals (ms)
SIM_FERROVIA_INTERVAL=10000
SIM_TRUCK_INTERVAL=2000

# Device list (JSON array, optional — uses defaults if not set)
# DEVICES=[{"name":"FERROVIA_SW","mac":"98:D3:31:FD:15:F5","type":"ferrovia"},{"name":"TRUCK_T01","mac":"98:D3:31:FD:15:A1","type":"truck"}]

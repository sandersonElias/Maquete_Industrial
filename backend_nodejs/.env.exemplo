# Back-end - Maquete Industrial

# Servidor
PORT=4000
NODE_ENV=development

# Banco de Dados - Supabase (connection string)
DATABASE_URL=postgresql://postgres.PROJECT_REF:SENHA@aws-0-us-east-1.pooler.supabase.com:6543/postgres

# Banco de Dados - Local (fallback se DATABASE_URL não definido)
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=maquete_industrial
# DB_USER=postgres
# DB_PASSWORD=sua_senha

# Redis (estado em tempo real)
REDIS_URL=redis://localhost:6379

# JWT
JWT_SECRET=chave_secreta_para_desenvolvimento
JWT_EXPIRES_IN=24h

# Gateway
GATEWAY_API_KEY=chave_api_gateway

# Logging
LOG_LEVEL=info

# CORS (permitir origens específicas em produção)
CORS_ORIGIN=*

# Timeout de comandos (ms)
COMMAND_TIMEOUT_MS=30000